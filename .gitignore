# Dependências
node_modules/

# dist/ de servers (gerado localmente, não necessário no repo)
packages/servers/*/dist/

# dist/ dos shared packages é commitado para evitar necessidade de tsc na instalação
# (não adicionar 'dist/' global aqui)

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
.env
*.local

# Credenciais de autenticação — nunca commitar
# (geradas automaticamente em ~/.sap-mcp/auth.json)
auth.json

# Artefatos locais de desenvolvimento
*.bak-*
scratch/
dcd-contracts-*/
snap-*.md
opp-*.png

# Planos do Claude Code (uso interno)
.claude/plans/
